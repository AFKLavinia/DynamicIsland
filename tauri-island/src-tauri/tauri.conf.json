{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DynamicIsland",
  "version": "0.2.0",
  "identifier": "com.dynamicisland.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DynamicIsland",
        "width": 600,
        "height": 240,
        "x": 383,
        "y": 0,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
